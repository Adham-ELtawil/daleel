# Daleel environment. Copy to .env.local (ignored by git) and fill in what you need.
# Every variable below is read by the app or its scripts; defaults are safe for a zero-key demo.

# ---------- Meta Model API (server only) ----------
# Your own Meta Model API key. Leave empty to run the recorded demo (DEMO_REPLAY=1).
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# 1 = serve recorded Muse Spark responses from recordings/ for the seeded demo examples
#     (no key, no network, zero cost; never falls back to a live call).
# 0 = live Meta calls with MODEL_API_KEY.
DEMO_REPLAY=0
# Scripts only; `pnpm record:demo` sets this itself. Never set it for the web app.
DEMO_RECORD=0
# Scripts only: 1 = `pnpm record:demo` keeps existing recordings and only adds missing ones.
RECORD_REUSE=0

# ---------- Model and reasoning effort per pipeline step ----------
# Effort: minimal | low | medium | high | xhigh
# Replay recordings are keyed by a hash of the exact request (model + effort + prompt),
# so keep these defaults when using DEMO_REPLAY=1.
MODEL_DIAGNOSE=muse-spark-1.3
EFFORT_DIAGNOSE=high
MAXTOK_DIAGNOSE=16000

MODEL_STRESS=muse-spark-1.3
EFFORT_STRESS=medium
MAXTOK_STRESS=16000

# Hint ladder, idea hints and diagnosis translation (translation always uses minimal effort).
MODEL_LADDER=muse-spark-1.3
EFFORT_LADDER=low
MAXTOK_LADDER=8000

# Full explanation + animated walkthrough. `low` is ~2x faster live but will not match recordings.
MODEL_EXPLAIN=muse-spark-1.3
EFFORT_EXPLAIN=medium
MAXTOK_EXPLAIN=16000

# Model used only by `pnpm smoke:meta` (connectivity check).
MODEL_NORMALIZE=muse-spark-1.3

# Prompt cache retention hint: in_memory | 24h
PROMPT_CACHE_RETENTION=24h

# ---------- Cost guards ----------
# Hard daily cap on live Meta spend (sum of llm_calls.cost_usd since 00:00 UTC). Calls stop at the cap.
DAILY_BUDGET_USD=10
# `pnpm eval` stops before the next case when the run reaches this cost.
EVAL_MAX_USD=1.00
# `pnpm record:demo` cap per recording run.
RECORD_MAX_USD=0.50

# ---------- Code runner ----------
# none  = no compilation; diagnosis and hints still work, counterexamples show "Not verified".
# local = compile and run C++17 in a bubblewrap sandbox (Linux, or the Docker image).
#         Needs g++, bubblewrap, prlimit/timeout and unprivileged user namespaces.
#         Check with `pnpm smoke:runner` (no Meta calls).
RUNNER_PROVIDER=none

# ---------- Database ----------
# Local SQLite file (created by `pnpm db:migrate`). Turso also works: libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/daleel.db
DATABASE_AUTH_TOKEN=

# ---------- Sessions ----------
# Required in production (`pnpm build && pnpm start`): at least 32 characters, e.g. `openssl rand -hex 32`.
# Empty in development = a temporary secret is generated (sessions reset on restart).
SESSION_SECRET=

# ---------- Problem intake ----------
# Codeforces pages are often behind Cloudflare; when fetching fails the app asks you to paste the statement.
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36
CF_API_BASE_URL=https://codeforces.com/api
