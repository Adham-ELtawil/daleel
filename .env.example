# ---------- Meta Model API (server only) ----------
# Create a key in the Meta Model API dashboard. Never commit a real value.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model per pipeline step (see docs/03-ARCHITECTURE.md §5.4).
# Dev traffic may use muse-spark-1.3-contributor (cheaper, content may train Meta models) ONLY if the owner agrees.
MODEL_DIAGNOSE=muse-spark-1.3
MODEL_STRESS=muse-spark-1.3
MODEL_LADDER=muse-spark-1.3
MODEL_EXPLAIN=muse-spark-1.3
MODEL_REPORT=muse-spark-1.3
MODEL_NORMALIZE=muse-spark-1.3

# Reasoning effort per step: minimal | low | medium | high | xhigh   ("none" is rejected by Muse Spark)
EFFORT_DIAGNOSE=high
EFFORT_STRESS=medium
EFFORT_LADDER=low
EFFORT_EXPLAIN=medium
EFFORT_REPORT=medium
EFFORT_NORMALIZE=low

# Diagnose completion budget includes Muse Spark's reasoning tokens at high effort.
MAXTOK_DIAGNOSE=16000
# Ladder completion budget includes Muse Spark's reasoning tokens, even at low effort.
MAXTOK_LADDER=8000

# Prompt cache retention hint: in_memory | 24h
PROMPT_CACHE_RETENTION=24h

# ---------- Cost guards ----------
DAILY_BUDGET_USD=10
# Eval stops before the next diagnosis when cumulative run cost reaches this cap.
EVAL_MAX_USD=1.00
# Recording reserves a conservative maximum cost before each call and retry.
RECORD_MAX_USD=0.50
MAX_ATTEMPTS_PER_USER_PER_DAY=30

# ---------- Optional fallback provider (OpenAI-compatible; open-weight Meta model) ----------
# e.g. a host serving Muse Spark Open or a Llama model. Leave empty to disable.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------- Speech to text (stretch) ----------
ASR_ENABLED=false
ASR_MODEL=muse-voice-transcribe-1.0

# ---------- Code runner ----------
# local | none (default none). Local = host C++17 compiler + bubblewrap sandbox.
# Install on Debian/Ubuntu: sudo apt install g++ bubblewrap
# Requires unprivileged user namespaces, plus timeout/prlimit (coreutils/util-linux).
# Enable with RUNNER_PROVIDER=local; verify with pnpm smoke:runner.
RUNNER_PROVIDER=none
RUNNER_CPU_SECONDS=2
RUNNER_MEMORY_MB=256
RUNNER_MAX_TESTS=12

# ---------- Database ----------
# Local: file:./data/daleel.db   Prod (Turso): libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/daleel.db
DATABASE_AUTH_TOKEN=

# ---------- App ----------
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
DEFAULT_LOCALE=ar-EG
# 1 = serve recorded LLM responses for the seeded demo examples (shows a "replay" badge)
DEMO_REPLAY=0
# Scripts only; pnpm record:demo enables this automatically. Never set it for pnpm dev.
DEMO_RECORD=0

# ---------- External sites ----------
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36
CF_API_BASE_URL=https://codeforces.com/api

# ---------- Muse Code (the coding agent, NOT the app) ----------
# Muse Code reads META_API_KEY from your shell environment. Do not put it in this file.
